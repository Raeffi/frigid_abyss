ForgeEvents.onEvent($CHUNK_LOAD, (e) => {

    if (!Utils.server.persistentData.hasOwnProperty("pendingChunks")) {
        Utils.server.persistentData.put("pendingChunks", []);
        console.log("!!! INITIALIZE pendingChunks !!!");
    }

    let pendingChunks = Utils.server.persistentData.get("pendingChunks");

    let level = e.getLevel();
    if (!level || level.dimension !== "lostcities:lostcity") return;

    let chunk = e.getChunk();
    let chunkKey = chunk.getPos().x + "_" + chunk.getPos().z;
    let regionKey = chunk.getPos().getRegionX() + "_" + chunk.getPos().getRegionZ();

    let data = Utils.server.persistentData;

    if (!data.hasOwnProperty("regions")) {
        data.put("regions", {});
        console.log("!!! INITIALIZE regions !!!");
    }
        
    let regions = data.get("regions");

    if (!regions.hasOwnProperty(regionKey)){
        regions[regionKey] = {};
        console.log("!!! ADDED NEW REGION" + regionKey + "!!!");
    }

    if (!regions[regionKey][chunkKey]) {
        
        // Just schedule the chunk to be processed later
        console.log("New Chunk Loaded at" + chunkKey );
        pendingChunks.push({
            x: chunk.getPos().x,
            z: chunk.getPos().z,
        });
        regions[regionKey][chunkKey] = false;
    }
});


